# --- Base de datos (PostgreSQL / Netlify DB sobre Neon) ---
# En Netlify las dos variables las inyecta Netlify DB automaticamente.
# NETLIFY_DATABASE_URL: conexion pooled, la usa la API en runtime.
NETLIFY_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
# NETLIFY_DATABASE_URL_UNPOOLED: conexion directa, la usa Prisma Migrate.
# En local puede ser la misma URL que NETLIFY_DATABASE_URL.
NETLIFY_DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# --- Autenticacion ---
JWT_SECRET="cambiar-por-un-secret-largo"
JWT_EXPIRES_IN="8h"

# --- Solo servidor local (npm run dev:api) ---
PORT=3002
