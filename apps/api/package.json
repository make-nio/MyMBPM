{
  "name": "@myfirstproject/api",
  "version": "1.0.0",
  "private": true,
  "description": "Backend API for the BPM system.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "coverage:e2e": "c8 report --temp-directory coverage/e2e-raw --reports-dir coverage/e2e --reporter=json --reporter=text-summary --src src --include \"src/**/*.ts\" --exclude \"src/**/*.test.ts\" --exclude-after-remap",
    "test:watch": "vitest",
    "postinstall": "prisma generate",
    "respaldo:respaldar": "tsx scripts/respaldo.ts respaldar",
    "respaldo:restaurar": "tsx scripts/respaldo.ts restaurar",
    "respaldo:probar-ciclo": "tsx scripts/respaldo.ts probar-ciclo",
    "prisma:format": "prisma format",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:status": "prisma migrate status",
    "prisma:db:push": "prisma db push",
    "prisma:db:pull": "prisma db pull"
  },
  "dependencies": {
    "@netlify/blobs": "^11.1.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "serverless-http": "^3.2.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.13.10",
    "@vitest/coverage-v8": "^3.2.7",
    "c8": "^12.0.0",
    "prisma": "^7.10.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.2.7"
  }
}
